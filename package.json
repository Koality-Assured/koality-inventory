{
  "name": "koality-inventory",
  "version": "0.1.0",
  "private": true,
  "description": "Enterprise inventory platform with a dual-database core and OpenAPI services.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -b && npm run typecheck -w @koality-inventory/web",
    "dev:api": "npm run dev -w @koality-inventory/api",
    "dev:web": "npm run dev -w @koality-inventory/web",
    "test": "vitest run",
    "format:check": "prettier --check .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^24.7.0",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0",
    "vitest": "^5.0.3"
  }
}
